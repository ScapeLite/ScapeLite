{
  "name": "scapelite",
  "version": "0.4.0",
  "description": "ScapeLite - a plugin-based overlay and planner for Scapewatch: Idle MMO (display-only, RuneLite-style plugin marketplace).",
  "private": true,
  "main": "app/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node overlay/supervisor.js",
    "extract-data": "node overlay/gamedata.js --force",
    "planner": "node src/server.js",
    "test": "node src/data.js",
    "build-site": "node scripts/build-site.js",
    "launch": "node overlay/launcher.js launch",
    "game-status": "node overlay/launcher.js status",
    "app": "electron .",
    "dist": "npm run test:package && electron-builder --win",
    "pack": "npm run test:package && electron-builder --win --dir",
    "test:route": "node scripts/test-route-advisor.js",
    "test:log": "node scripts/test-log.js",
    "test:discord": "node scripts/test-discord.js",
    "test:board": "node scripts/test-clan-board.js",
    "test:relay": "node scripts/test-relay.js",
    "design-lab": "node design-lab/serve.js",
    "roadmap": "node scripts/roadmap.js",
    "roadmap-server": "node roadmap/server.js",
    "verify:package": "node scripts/verify-package.js",
    "test:package": "node scripts/test-package.js",
    "test:state": "node scripts/test-state.js",
    "test:bridge": "node scripts/test-bridge-snapshot.js",
    "test:watchdog": "node scripts/test-watchdog.js",
    "test:logrotate": "node scripts/test-log-rotate.js",
    "test:cards": "node scripts/test-cards.js",
    "test:diary": "node scripts/test-diary-credits.js",
    "test:advisor": "node scripts/test-advisor-core.js",
    "test:commands": "node scripts/test-chat-commands.js",
    "test:onboarding": "node scripts/test-onboarding.js",
    "test:default-layout": "node scripts/test-default-layout.js",
    "test:drop-luck": "node scripts/test-drop-luck.js",
    "lint:forwards": "node scripts/lint-forwards.js",
    "test:calibration": "node scripts/test-roll-calibration.js",
    "test:option-log": "node scripts/test-option-log.js",
    "test:slay-correction": "node scripts/test-slay-correction.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8"
  },
  "author": "ScapeLite",
  "build": {
    "appId": "app.scapelite.desktop",
    "productName": "ScapeLite",
    "copyright": "ScapeLite",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "!**/*",
      "package.json",
      "app/main.js",
      "branding/*.svg",
      "branding/png/*.png",
      "overlay/*.js",
      "overlay/logging/*.js",
      "overlay/cards/*.js",
      "overlay/catalog.json",
      "overlay/community.json",
      "overlay/app-info.json",
      "overlay/*.example.json",
      "overlay/*.png",
      "overlay/catalog-img/*.png",
      "website/**/*.{html,js,css,json,png,svg}",
      "examples/plugins/**/*.{js,json,md}",
      "docs/PLUGINS.md",
      "docs/SUBMIT-A-PLUGIN.md",
      "docs/PLUGIN-AUTHOR-GUIDE.md",
      "!overlay/authors.local.example.json",
      "!overlay/local-config.example.json",
      "!**/*-config.json",
      "!**/*-state.json",
      "!**/*webhook*",
      "!**/*.local.json",
      "!**/*.{bak,tmp,lock,log,corrupt,orig,rej,moved,map}",
      "!**/State/**",
      "!**/.env*",
      "!**/nul"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "branding/png/logo-512.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "scripts/after-pack.js"
  }
}
